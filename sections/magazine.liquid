                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-item">
                <div class="magazines__plan">
                  <div class="magazines__plan--header">RECOMENDADO</div>
                  <div class="magazines__plan--content">
                    <p class="magazines__plan--caption">ANNUAL SUBSCRIPTION E-BONO</p>
