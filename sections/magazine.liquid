{% capture content %}
{{ 'section-magazine.css' | asset_url | stylesheet_tag }}

{%- comment -%} Market Detection and Logging {%- endcomment -%}
{%- assign current_market = localization.market.handle -%}
{%- assign market_name = localization.market.name -%}
{%- assign market_iso_code = localization.market.iso_code -%}
{%- assign shop_currency = shop.currency -%}

<script>
  console.log('=== MARKET DEBUG INFO ===');
  console.log('entire object localization','{{ localization }}')
  console.log('section data','{{ section }}')
  console.log('Market Handle:', '{{ current_market }}');
  console.log('Market Name:', '{{ market_name }}');
  console.log('Market ISO Code:', '{{ market_iso_code }}');
  console.log('Shop Currency:', '{{ shop_currency }}');
  console.log('Request Host:', '{{ request.host }}');
  console.log('========================');
  
   
  // Log entire localization object (access properties directly since json filter doesn't work)
  console.log('=== ENTIRE LOCALIZATION OBJECT ===');
  console.log('entire object localization', '{{ localization }}');
  console.log('localization.market.handle:', '{{ localization.market.handle }}');
  console.log('localization.market.name:', '{{ localization.market.name }}');
  console.log('localization.market.iso_code:', '{{ localization.market.iso_code }}');
  console.log('localization.language.iso_code:', '{{ localization.language.iso_code }}');
  console.log('localization.language.endonym_name:', '{{ localization.language.endonym_name }}');
  console.log('localization.currency.iso_code:', '{{ localization.currency.iso_code }}');
  console.log('localization.currency.symbol:', '{{ localization.currency.symbol }}');
  console.log('===================================');
  
  // Log entire section object (access properties directly since json filter doesn't work)
  console.log('=== ENTIRE SECTION OBJECT ===');
  console.log('section data', '{{ section }}');
  console.log('section.id:', '{{ section.id }}');
  console.log('section.type:', '{{ section.type }}');
  console.log('section.settings.collection.products:', '{{ section.settings.collection.products }}');
  console.log('section.settings.domain:', '{{ section.settings.domain }}');
  console.log('section.settings.padding_top:', '{{ section.settings.padding_top }}');
  console.log('section.settings.padding_bottom:', '{{ section.settings.padding_bottom }}');
  console.log('section.blocks count:', {{ section.blocks.size }});
  {% for block in section.blocks %}
  console.log('section.blocks[{{ forloop.index0 }}].type:', '{{ block.type }}');
  {% endfor %}
  console.log('==============================');
</script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.image %}
<div class="responsive-banner">
  <picture>
      <!-- For devices with a viewport width of 768px and up -->
      <source media="(min-width: 750px)" srcset="{{ section.settings.image | img_url: '2048x' }}" loading="lazy" alt="{{ section.settings.image.alt }}">
      
      <!-- For devices with a viewport width below 768px -->
      <img width="1500" height="auto" src="{{ section.settings.image_mobile | img_url: '1500x' }}" loading="lazy" alt="{{ section.settings.image_mobile.alt }}">
  </picture>
</div>
{% endif %}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h1
                class="magazines__heading rte inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </h1>
              <div
                class="rich-text__text magazines__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.text }}
              </div>
            {%- when 'caption' -%}
              
            {%- when 'text' -%}
              
            {%- when 'button' -%}
              <div
                class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_2 }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
        <div class="magazines__gift-cards magazines__gift-cards--selector">
          <div
            class="rich-text__buttons scroll-trigger"
          >
              
              <a
                data-id="magazines__gift-cards--list"
                href="{{ block.settings.button_link_2 }}"
                class="button__gift"
              >
                <span class="button__gift-circle"></span>
                <span>It's a gift</span>
                <?xml version="1.0"?><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><defs><style>.a{fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.5px;}</style></defs><title>gift-box</title><path class="a" d="M21.75,11.25H2.25v10.5a1.5,1.5,0,0,0,1.5,1.5h16.5a1.5,1.5,0,0,0,1.5-1.5Z"></path><path class="a" d="M21.75,6.75H2.25a1.5,1.5,0,0,0-1.5,1.5V10.5a.75.75,0,0,0,.75.75h21a.75.75,0,0,0,.75-.75V8.25A1.5,1.5,0,0,0,21.75,6.75Z"></path><path class="a" d="M11.25,6.75c-3.314,0-6.75-2.686-6.75-6"></path><path class="a" d="M4.5.75c3.314,0,6.75,2.686,6.75,6"></path><path class="a" d="M12.75,6.75c3.314,0,6.75-2.686,6.75-6"></path><path class="a" d="M19.5.75c-3.314,0-6.75,2.686-6.75,6"></path><rect class="a" x="9.75" y="6.75" width="4.5" height="16.5"></rect></svg>
              </a>
          </div>
        </div>
        <div id="magazines__gift-cards--list" class="magazines__gift-cards magazines__gift-cards--list" style="display: none;">
          <hr>
          <h2
            class="magazines__gift-cards--heading rte inline-richtext h2 scroll-trigger"
          >
            Select your gift card
          </h2>
          <!-- Slider main container -->
          <div class="swiper gift-cards-swiper">
            <!-- Additional required wrapper -->
            <div class="swiper-wrapper">
              {% for product in section.settings.collection_gift_cards.products %}
              <!-- Slides -->
              <div class="swiper-slide">
                <a class="magazines__gift-card--item button-buy--gift-card"
                  data-title="{{ product.title | split: " - " | last }}"
                  data-variant-id="{{ product.first_available_variant.id }}"
                  data-price="{{ product.price | money }}"
                  href="#"
                  data-dl-product-name="{{ product.title }}" 
                  data-dl-product-id="{{ product.id }}" 
                  data-dl-product-price="{{ product.price | money_without_currency | replace: ",", "." }}" 
                  data-dl-product-brand="{{ product.vendor }}" 
                  data-dl-product-variant="{{ product.title }}"
                  data-dl-product-category="{{ product.type }}"
                >
                    <div class="magazines__gift-card--image">
                      <img src="{{ product.featured_image | img_url: '500x' }}" alt="{{ product.featured_image.alt }}">
                    </div>
                        
                  <div
                    class="button button--secondary button-buy--gift-card-text full-unstyled-link"
                  >
                    Select
                  </div>
                </a>
              </div>
              {% endfor %}
            </div>

            <!-- If we need pagination -->
            <div class="gift-cards-swiper-pagination"></div>

          </div>
          
          
        </div>
        <div id="magazines__location" class="magazines__location" style="display: block;">
          {% comment %} <h2
            class="magazines__gift-cards--heading section__heading rte inline-richtext h2 scroll-trigger"
          >
            Location
          </h2> {% endcomment %}
          <div
            class="rich-text__buttons rich-text__buttons--multiple scroll-trigger"
          >
              <a
                data-id="plans-national"
                href="#"
                class="button {% if localization.market.handle == "in"%}button--primary{% else %}button--secondary{% endif %} select-market active"
              >
                Print
              </a>

              <a
                data-id="plans-international"
                href="#"
                class="button {% if localization.market.handle != "in"%}button--primary{% else %}button--secondary{% endif %} select-market"
              >
                Best Seller
              </a>

               <a
                data-id="plans-international"
                href="#"
                class="button {% if localization.market.handle != "in"%}button--primary{% else %}button--secondary{% endif %} select-market"
              >
                Digital
              </a>

          </div>
        </div>
       
          {% comment %} <div id="magazines_product_collection" class="magazines_product_collection" style="display:block">
            <div  class="rich-text__buttons rich-text__buttons--multiple scroll-trigger"
          >
            <a
              data-id="print-subscription"
              href="#"
             class="button {% if localization.market.handle == "in"%}button--primary{% else %}button--secondary{% endif %} select-market active"
              >
              Print
            </a>
          </div> {% endcomment %}
       
        <div id="magazines__plans" class="magazines__plans" style="display: block;">
          <hr>
          <h2
            class="magazines__plans--heading section__heading rte inline-richtext h2 scroll-trigger"
          >
            Choose your subscription plan
          </h2>

            <!-- Slider main container -->
            <div id="plans-national" class="swiper plans-swiper  plans-count-{{ section.settings.collection.products.count }} active">
              <!-- Additional required wrapper -->
              <div class="swiper-wrapper">
                <!-- Slides -->
                
                {% for product in section.settings.collection.products %}
                  {% assign caption = "" %}
                  {% if product.metafields.custom.metatag != blank %}
                    {% assign caption = product.title | split: " - " | last %}
                  {% else %}
                    {% if product.metafields.custom.subheading != blank %}
                      {% assign caption = product.metafields.custom.subheading %}
                    {% endif %}
                  {% endif %}

                  <div class="swiper-slide">
                    <div class="magazines__plan {% if product.metafields.custom.selected_local %}active{% endif %}">
                      <div class="magazines__plan--header">{% if product.metafields.custom.metatag != blank %}{{ product.metafields.custom.metatag }}{% else %}{{ product.title | split: " - " | last }}{% endif %}</div>
                      <div class="magazines__plan--content">
                        {% if caption != blank %}
                        <p class="magazines__plan--caption">{{ caption }}</p>
                        {% endif %}
                        <h3 {% if caption == blank %}style="margin-top: 0;"{% endif %}  class="magazines__plan--heading rte inline-richtext h3">{{ product.metafields.custom.featured }}</h3>
                        {%- comment -%} Price Display with Discount Badge by susil {%- endcomment -%}
                        {%- assign variant = product.selected_or_first_available_variant -%}
                        {%- assign compare_at_price = variant.compare_at_price -%}
                        {%- assign price = variant.price -%}
                        {%- if compare_at_price > price -%}
                          {%- assign discount_amount = compare_at_price | minus: price -%}
                          {%- assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_at_price | round -%}
                          <div class="magazines__plan--price-wrapper">
                            <span class="magazines__plan--discount-badge">
                              {{ discount_percentage }}% OFF
                            </span>
                          </div>
                        {%- else -%}
                          <div class="magazines__plan--price-wrapper">
                            <div class="magazines__plan--price-container">
                              <span class="magazines__plan--price-regular">
                                {{ price | money }}
                              </span>
                            </div>
                          </div>
  {%- comment -%} Price Display with Discount Badge by susil {%- endcomment -%}
                        {%- endif -%}
                        <div>
                           <div class="magazines__plan--image-container">
                     
                        <div class="magazines__plan--image">
                          <img src="{{ product.featured_image | img_url: '200x' }}" alt="{{ product.featured_image.alt }}">
                        </div>
                        {% if product.metafields.custom.footer != blank %}<div class="magazines__plan--header magazines__plan--footer">{{ product.metafields.custom.footer }}</div>{% endif %}
                      </div>
                        </div>
                        <p class="magazines__plan--payment">{{ product.metafields.custom.payment }}</p>
                       
                        <div class="magazines__plan--features">
                          {{ product.description }}
                        </div>
                        
                      </div>
                      <div class="magazines__plan-bottom">
                        {% comment %} by susil  {% endcomment %}
                           {%- comment -%} Price Display in Footer {%- endcomment -%}
                        {%- assign variant = product.selected_or_first_available_variant -%}
                        {%- assign compare_at_price = variant.compare_at_price -%}
                        {%- assign price = variant.price -%}
                        {%- if compare_at_price > price -%}
                          <div class="magazines__plan--price-wrapper">
                            <div class="magazines__plan--price-container">
                              <span class="magazines__plan--price-sale">
                                {{ price | money }}
                              </span>
                              <span class="magazines__plan--price-compare">
                                <s>{{ compare_at_price | money }}</s>
                              </span>
                            </div>
                          </div>
                        {%- else -%}
                          <div class="magazines__plan--price-wrapper">
                            <div class="magazines__plan--price-container">
                              <span class="magazines__plan--price-regular">
                                {{ price | money }}
                              </span>
                            </div>
                          </div>
                        {%- endif -%}
                        <a
                          {% if product.selected_or_first_available_selling_plan_allocation %}
                            data-selling-plan="{{ product.selected_or_first_available_selling_plan_allocation.selling_plan.id }}" data-price="{{ product.price | money }}"        
                          {% else %}
                            data-price="{{ product.price | money }}"
                          {% endif %} 
                            data-frequency="{{ product.metafields.custom.frequency }}"
                            data-requires-selling-plan="{{ product.requires_selling_plan }}"
                              data-monthly="{{ product.metafields.custom.monthly }}" 
                            {% if product.metafields.custom.e_bono %}data-e-bono="{{ product.metafields.custom.e_bono }}"{% endif %}
                            data-id="{{ product.id }}" 
                            data-variant-id="{{ product.first_available_variant.id }}"  
                            data-title="{{ product.title | split: " - " | last }}" 
                            href="" 
                            class="magazines__plan--button button" 
                            data-dl-product-name="{{ product.title }}" 
                            data-dl-product-id="{{ product.id }}" 
                            data-dl-product-price="{{ product.price | money_without_currency | replace: ",", "." }}" 
                            data-dl-product-brand="{{ product.vendor }}" 
                            data-dl-product-variant="{{ product.title }}" 
                            data-dl-product-category="{{ product.type }}" >
                            {% if product.metafields.custom.selected_local %}
                              Selected
                            {% else %}
                              Select
                            {% endif %}
                        </a>
                      </div>
                         {% comment %} by susil  {% endcomment %}
                     
                    </div>
                  </div>
                {% endfor %}
              </div>

              <!-- If we need pagination -->
              <div class="plans-swiper-pagination"></div>

            </div>

            <!-- Slider main container -->
            
            {% assign international_count = 0 %}
            {% for product in section.settings.collection.products %}
              {% if product.metafields.custom.international %}
                {% assign international_count = international_count | plus: 1 %}
              {% endif %}
            {% endfor %}
            
