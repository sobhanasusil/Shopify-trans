<script>
  // First, we need to get the checkbox, email input elements and the error message wrapper by their name attributes/classes
  var checkbox = document.querySelector('input[name="items[0]properties[__shopify_send_gift_card_to_recipient]"]');
  var emailInput = document.querySelector('input[name="items[0]properties[Recipient email]"]');
  var errorMessageWrapper = document.querySelector('.product-form__recipient-error-message-wrapper');
  
  // Then we need to get the form
  var form = document.querySelector('.checkout-form');
  
  // Now we can attach an event listener to the form's submit event
  form.addEventListener('submit', function(event) {
    // We only want to prevent the form from being submitted if the checkbox is checked and the email input is empty
    if (checkbox.checked && emailInput.value === '') {
      event.preventDefault();
      checkbox.checked = false;
      // Remove the hidden attribute from the error message wrapper
      // errorMessageWrapper.removeAttribute('hidden');
      // Get the top position of the form and subtract 200px
      // var topPos = form.getBoundingClientRect().top + window.pageYOffset - 200;
      // Smooth scroll to the position above the form
      // window.scrollTo({ top: topPos, behavior: 'smooth' });
    } else {
      // If the user corrected the input, we need to ensure that the error message gets hidden again
      errorMessageWrapper.setAttribute('hidden', '');
    }

    let products = []; // to collect products
    
    let item0 = form.querySelector('input[name="items[0]id"]');
    if (item0) {
        let product0 = {
            'name': item0.getAttribute('data-dl-product-name'),
            'id': item0.getAttribute('data-dl-product-id'),
            'price': item0.getAttribute('data-dl-product-price'),
            'brand': item0.getAttribute('data-dl-product-brand'),
            'category': item0.getAttribute('data-dl-product-category'),
            'variant': item0.getAttribute('data-dl-product-variant'),
            'quantity': "1"
        };
        products.push(product0);
    }

    let item1 = form.querySelector('input[name="items[1]id"]');
    if (item1) {
        let product1 = {
            'name': item1.getAttribute('data-dl-product-name'),
            'id': item1.getAttribute('data-dl-product-id'),
            'price': item1.getAttribute('data-dl-product-price'),
            'brand': item1.getAttribute('data-dl-product-brand'),
            'category': item1.getAttribute('data-dl-product-category'),
            'variant': item1.getAttribute('data-dl-product-variant'),
            'quantity': "1"
        };
        products.push(product1);
    }

    if (products.length) {
        dataLayer.push({ ecommerce: null }); // Clear the previous ecommerce object.
        dataLayer.push({
            'event': 'add-to-cart',
            'ecommerce': {
                'currencyCode': 'EUR',
                'add': {
                    'products': products
                }
            },
            'eventCallback': function() {
                form.submit(); // Submit the form after the dataLayer push
            }
        });
    } else {
        // If no products, submit the form directly
        form.submit();
    }
  });
</script>

