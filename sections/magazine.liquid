                    {% if product.metafields.custom.international_subheading != blank %}
                      {% assign caption = product.metafields.custom.international_subheading %}
                    {% endif %}
                  {% endif %}

                  <div class="swiper-slide">
                    <div class="magazines__plan {% if forloop.index == preselect %}active{% endif %}">
                      <div class="magazines__plan--header">{% if product.metafields.custom.international_metatag != blank %}{{ product.metafields.custom.international_metatag }}{% else %}{{ product.title | split: " - " | last }}{% endif %}
                        <div class="magazines__plan--image">
                          <img src="{{ product.featured_image | img_url: '200x' }}" alt="{{ product.featured_image.alt }}">
                        </div>
                      </div>
