                       {% comment %} by susil  {% endcomment %}
                          {%- comment -%} Discount Badge - Top Left Corner {%- endcomment -%}
                        {%- assign variant = product.selected_or_first_available_variant -%}
                        {%- assign compare_at_price = variant.compare_at_price -%}
                        {%- assign price = variant.price -%}
                        {%- if compare_at_price > price -%}
                          {%- assign discount_amount = compare_at_price | minus: price -%}
                          {%- assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_at_price | round -%}
                          <span class="magazines__plan--discount-badge">
                            {{ discount_percentage }}% Off
                          </span>
                        {%- endif -%}
                        {% comment %} by susil  {% endcomment %}
                        <p class="magazines__plan--payment">{{ product.metafields.custom.international_payment }}</p>
                        <a 
                          {% if product.selected_or_first_available_selling_plan_allocation %}
                            {% comment %} {% if product.metafields.custom.monthly == true %}
                              data-selling-plan="{{ product.selected_or_first_available_selling_plan_allocation.selling_plan.id }}" data-price="{{ product.price | times: 12 | money }}"
                            {% else %}
                              data-selling-plan="{{ product.selected_or_first_available_selling_plan_allocation.selling_plan.id }}" data-price="{{ product.price | money }}"
                            {% endif %} {% endcomment %}
                            data-selling-plan="{{ product.selected_or_first_available_selling_plan_allocation.selling_plan.id }}" data-price="{{ product.price | money }}"                          
                          {% else %}
                            data-price="{{ product.price | money }}"
                          {% endif %} 
                            data-frequency="{{ product.metafields.custom.frequency }}"
                            data-requires-selling-plan="{{ product.requires_selling_plan }}"
                              data-monthly="{{ product.metafields.custom.monthly }}" 
                            data-id="{{ product.id }}" 
                            data-variant-id="{{ product.first_available_variant.id }}"  
                            data-title="{{ product.title | split: " - " | last }}" 
                            href="" 
                            class="magazines__plan--button button"
                            data-dl-product-name="{{ product.title }}" 
                            data-dl-product-id="{{ product.id }}" 
                            data-dl-product-price="{{ product.price | money_without_currency | replace: ",", "." }}" 
                            data-dl-product-brand="{{ product.vendor }}" 
                            data-dl-product-variant="{{ product.title }}" 
                            data-dl-product-category="{{ product.type }}" >
                            {% if product.metafields.custom.selected_international %}
                              Selected
                            {% else %}
                              Select
                            {% endif %}
                            </a>
                        <div class="magazines__plan--features">
                          {{ product.metafields.custom.international_description | metafield_tag }}
                        </div>
                      </div>
                      <div class="magazines__plan-bottom">
                        
                        {% if product.metafields.custom.international_footer != blank %}<div class="magazines__plan--header magazines__plan--footer">{{ product.metafields.custom.international_footer }}</div>{% endif %}
                      </div>
                    </div>
                  </div>
                  {% endif %}
                {% endfor %}
              </div>

              <!-- If we need pagination -->
              <div class="plans-swiper-pagination"></div>

            </div>

            {% comment %} <div class="flex-container magazines__plans--container">
              <div class="flex-item">
                <div class="magazines__plan">
                  <div class="magazines__plan--header">ANNUAL SUBSCRIPTION HOME DELIVERY</div>
                  <div class="magazines__plan--content">
