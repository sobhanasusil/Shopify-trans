{% capture content %}
{{ 'section-magazine.css' | asset_url | stylesheet_tag }}
{{ 'section-subscription-promo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign product = section.settings.product -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
        <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
            <div class="rich-text__blocks {{ section.settings.content_alignment }}">
                {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'heading' -%}
                    <h1
                        class="magazines__heading rte inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {{ block.shopify_attributes }}
                        {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                        {% endif %}
                    >
                        {{ block.settings.heading }}
                    </h1>
                    <div
                        class="rich-text__text magazines__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {{ block.shopify_attributes }}
                        {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                        {% endif %}
                    >
                        {{ block.settings.text }}
                    </div>
                    {%- when 'caption' -%}
                    
                    {%- when 'text' -%}
                    
                    {%- when 'button' -%}
                    <div
                        class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {{ block.shopify_attributes }}
                        {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                        {% endif %}
                    >
                        {%- if block.settings.button_label != blank -%}
                        <a
                            {% if block.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                            {% else %}
                            href="{{ block.settings.button_link }}"
                            {% endif %}
                            class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        >
                            {{- block.settings.button_label | escape -}}
                        </a>
                        {%- endif -%}
                        {%- if block.settings.button_label_2 != blank -%}
                        <a
                            {% if block.settings.button_link_2 == blank %}
                            role="link" aria-disabled="true"
                            {% else %}
                            href="{{ block.settings.button_link_2 }}"
                            {% endif %}
                            class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                        >
                            {{- block.settings.button_label_2 | escape -}}
                        </a>
                        {%- endif -%}
                    </div>
                {%- endcase -%}
                {%- endfor -%}

                <div class="quiosco-wrapper">
                    <h1 class="qiosco-headline">{{ section.settings.title }}</h1>

                    <div class="subscription-promo">
                        <p class="subscription-promo__label">{{ section.settings.label }}</p>
                        <div class="subscription-promo__container">
                            <div class="subscription-promo__header">
                                {% comment %} <span class="subscription-promo__compare-at-price">{{ product.compare_at_price | money }}</span>  {% endcomment %}
                                <h2>{{ section.settings.box_title }}</h2>
                                <p>{{ section.settings.box_subtitle }}</p>
                            </div>
                            <div class="subscription-promo__content">
                                <div class="subscription-promo__image" style="background-image: url({{ section.settings.image | img_url: '2048x' }})"></div>
                                <div class="subscription-promo__info">
                                    <div class="subscription-promo__list">
                                        {{ section.settings.list }}
                                    </div>
                                    <div class="subscription-promo__benefit">
                                        {{ section.settings.benefit }}
                                    </div>
                                    <div class="subscription-promo__conditions">
                                        {{ section.settings.conditions }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {% assign show_stores = true %}
                {% assign show_stores_default = true %}
                
                {% if show_stores == true %}
                <div id="magazines__store-locator" class="magazines__store-locator">
                        <a href="#" id="open-locator" class="button button--secondary button--locator{% if show_stores_default %} show{% endif %}">*Find the nearest kiosk</a>

                        <div class="ebono-container" id="cabecera">
                            <div id="formulario">
                                    <form id="formData">
                                    <input id="tipo" type="hidden" name="tipo" value="0">
                                    <div class="customer">
                                        <div class="recipient-fields">
                                        <div class="recipient-fields__field">
                                            <div class="field">
                                            <input
                                                class="field__input"
                                                id="valor"
                                                type="text"
                                                placeholder="Enter postal code..."
                                                name="valor"
                                            >
                                            <label class="field__label" for="valor">
                                                <span class="recipient-email-label required">Postal code</span>
                                            </label>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
                                    <div>
                                    <button type="submit" id="boton" class="button button--primary">Search</button>
                                </form>
                            </div>
                            <!-- div in which the iframe with the map will be loaded -->
                            <div id="listado"></div>
                                    
                            <script type="text/javascript" charset="utf-8">// <![CDATA[
                                document.addEventListener('DOMContentLoaded', function() {

                                    const form = document.querySelector("#formData");
                                    const valor = form.querySelector("#valor");
                                    const tipo = form.querySelector("#tipo");
                                    const listado = document.querySelector("#listado");

                                    function validateForm() {
                                        const valorLength = valor.value.length;
                                        if (tipo.value == "0") {
                                            return valorLength === 5;
                                        } else {
                                            return valorLength >= 1 && valorLength <= 125;
                                        }
                                    }

                                    form.addEventListener('submit', function(e) {
                                        e.preventDefault();

                                        if (!validateForm()) {
                                            alert("Invalid input");
                                            return;
                                        }

                                        const pTipo = tipo.value;
                                        const pValor = valor.value;

                                        if( pTipo === '0' ) {
                                            listado.innerHTML = '<div class="responsive-iframe-container"><iframe scrolling="no" src="https://servicios.gpress.renr.es/manager/localizadorapiv3/mapabonos.jsp?cp=' + pValor + '&mostrar=on&h=500&w=500"></iframe></div>';
                                        } else {
                                            listado.innerHTML = '<div class="responsive-iframe-container"><iframe scrolling="no" src="https://servicios.gpress.renr.es/manager/localizadorapiv3/mapabonos.jsp?cp=' + pValor + '&mostrar=on&h=500&w=500"></iframe></div>';
                                        }
                                    });

                                    tipo.addEventListener('change', function() {
                                        if (this.value === "0") {
                                            valor.setAttribute("placeholder", "Enter postal code...");
                                        } else if (this.value === "1") {
                                            valor.setAttribute("placeholder", "Enter address...");
                                        }
                                    });

                                });
                            
                            // ]]>
                            </script>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="separator"></div>

                <div id="magazines__confirmation" class="magazines__confirmation" style="display: block;">

                    {%- assign product_form_id = 'product-form-' | append: section.id -%}
                    
                    {%- form 'product', product, id: product_form_id, class: 'form checkout-form', data-type: 'add-to-cart-form' -%}
                        {% render 'gift-card-recipient-form-home', product: product, form: form, section: section %}
                        
                        <h2 class="magazines__confirmation--heading section__heading rte inline-richtext h2 scroll-trigger">
                            {{ 'general.subscription.confirmation' | t }}
                        </h2>

                        <div class="magazines__confirmation--summary">
                            <div class="magazines__confirmation--summary-info">
                                <div class="magazines__confirmation--summary-product">
                                    <p>{{ product.title | split: " - " | last }}</p>
                                    <p class="renewal--yearly {% unless product.metafields.custom.monthly %}active{% endunless %}">
                                        {{ 'general.subscription.renewal' | t }}
                                    </p>
                                    <p class="renewal--monthly {% if product.metafields.custom.monthly %}active{% endif %}">
                                        {{ 'general.subscription.renewal_monthly' | t }}
                                    </p>
                                </div>
                                <div class="magazines__confirmation--summary-features">
                                    {{ product.description }}
                                </div>
                                <p class="magazines__confirmation--summary-frequency">{{ product.metafields.custom.frequency }}</p>
                            </div>

                            <div class="magazines__confirmation--summary-price">
                                <p>{{ product.price | money }}</p>
                            </div>
                        </div> 

                        <div class="magazines__confirmation--disclaimer active">
                            <p>{{ 'general.subscription.title' | t }}</p>
                            <p class="disclaimer--yearly {% unless product.metafields.custom.monthly %}active{% endunless %}">
                                {{ 'general.subscription.text' | t }}
                            </p>
                            <p class="disclaimer--monthly {% if product.metafields.custom.monthly %}active{% endif %}">
                                {{ 'general.subscription.text_mensual' | t }}
                            </p>
                        </div>
                        
                        <div class="terms-checkbox">
                            <div class="custom-checkbox">
                                <input type="checkbox" id="termsCheckbox" required/>
                                <label for="termsCheckbox">{{ 'general.subscription.terms_html' | t }}</label>
                            </div>      
                        </div>  

                        <input type="hidden" name="return_to" value="checkout">
                        <input class="product-input" type="hidden" name="items[0]quantity" value="1">
                        <input class="product-input" type="hidden" name="items[0]id" value="{{ product.first_available_variant.id }}"
                            data-dl-product-name="{{ product.title }}" 
                            data-dl-product-id="{{ product.id }}" 
                            data-dl-product-price="{{ product.price | money_without_currency | replace: ',', '.' }}" 
                            data-dl-product-brand="{{ product.vendor }}" 
                            data-dl-product-variant="{{ product.title }}" 
                            data-dl-product-category="{{ product.type }}">
                        {% if product.selected_or_first_available_selling_plan_allocation %}
                            <input class="product-input" type="hidden" name="items[0]selling_plan" value="{{ product.selected_or_first_available_selling_plan_allocation.selling_plan.id }}">
                        {% endif %}
                        
                        <!-- Add to Cart Button -->
                        <input type="submit" class="button button--primary button--checkout" value="Confirmar">
                        
                    {% endform %} 

                </div>
                 
                {% if section.settings.gift != blank %}
                <div class="separator"></div>
                <a href="/" class="quiosco-home-delivery">
                    <span class="quiosco-home-delivery__content">
                        {{ section.settings.gift }}
                        <span class="button button--primary">Select</span>
                    </span>
                    <span class="quiosco-home-delivery__image" style="background-image: url({{ section.settings.gift_image | image_url: width: '800x' }})"></span> 
                </a>
                {% endif %}

            </div>
        </div>
    </div>
</div>

{% if localization.market.handle == "es"%}

  {% assign index_mobile = 1 %}
  {% if section.settings.collection.products.count < 3 %}
    {% assign index_mobile = 0 %}
  {% endif %}

  <script>
    const plansSwiper = new Swiper('.plans-swiper', { 
      // Optional parameters
      direction: 'horizontal',
      loop: false,
      slidesPerView: "auto",
      spaceBetween: 25,
      initialSlide: {{ index_mobile }},
      centeredSlides: true,
      breakpoints: {
          1010: {
              slidesPerView:3, 
              spaceBetween: 50,
              initialSlide: 1,
              centeredSlides: false,
              centerInsufficientSlides: true
          }
      },
      // If we need pagination
      pagination: {
        el: '.plans-swiper-pagination',
        clickable: true
      },
    });
  </script>
{% else %}
  <script>
    const plansSwiper = new Swiper('.plans-swiper', { 
      // Optional parameters
      direction: 'horizontal',
      loop: false,
      slidesPerView: 1,
      spaceBetween: 25,
      initialSlide: 1,
      centeredSlides: true,
      breakpoints: {
          1010: {
              slidesPerView:3, 
              spaceBetween: 50,
              initialSlide: 1,
              centeredSlides: true,
          }
      },
      // If we need pagination
      pagination: {
        el: '.plans-swiper-pagination',
        clickable: true
      },
    }); 
  </script>
{% endif %}

<script>
// Assuming giftCards is a list of all '.button-buy--gift-card' elements
let giftCards = document.querySelectorAll('.button-buy--gift-card');

// Removing 'active' class from all gift cards
giftCards.forEach(function(giftCard) {
  let buttonTextElement = giftCard.querySelector('.button-buy--gift-card-text');
  if (buttonTextElement) {
      buttonTextElement.innerText = 'select';
  }
});

// Adding click event listener
let giftCardForm = document.querySelector('.gift-card-recipient-form-home');

giftCards.forEach(function(giftCard) {
    giftCard.addEventListener('click', function(event) {
        event.preventDefault();
        
        // Remove 'active' class from all other cards and set their text to 'select'
        giftCards.forEach(function(otherCard) {
            let otherButtonTextElement = otherCard.querySelector('.button-buy--gift-card-text');
            if (otherButtonTextElement) {
                otherButtonTextElement.innerText = 'select';
            }
        });

         // Change the text of the clicked card's .button-buy--gift-card-text
         let buttonTextElement = giftCard.querySelector('.button-buy--gift-card-text');
         if (buttonTextElement) {
             buttonTextElement.innerText = 'selected';
         }

        // Add 'active' class to .gift-card-recipient-form-home
        giftCardForm.classList.add('active');
    });
});

// Gift cards form
document.querySelector('.button__gift').addEventListener('click', function() {
  // var inputs = document.querySelectorAll('.recipient-form input');
  // for (var i = 0; i < inputs.length; i++) {
  //     inputs[i].value = '';
  // }
  if (!this.classList.contains('active')) {
    dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
    dataLayer.push({
      'event': 'product-impression',
      'ecommerce': {
        'currencyCode': 'EUR',
        'impressions': [{% for product in section.settings.collection_gift_cards.products %}{
          'name': "{{ product.title }}",
          'id': "{{ product.id }}",
          'price': "{{ product.price | money_without_currency | replace: ",", "." }}", // Assuming giftsData has a price attribute
          'brand': "{{ product.vendor }}", // Update this as needed
          'category': "{{ product.type }}", // Update this as needed
          'variant': "{{ product.title }}",
          'list': "Homepage",
          'position': "{{ forloop.index }}"
        }{% unless forloop.last%},{% endunless %}{% endfor %}]
      }
    });
  }

  var openLocator = document.querySelector("#open-locator");
  var ebonoContainer = document.querySelector(".ebono-container");
  var listado = document.querySelector("#listado");
  var valor = document.querySelector("#valor");

  if (openLocator && openLocator.classList) {
    openLocator.classList.remove('show');
  }
  if (ebonoContainer && ebonoContainer.classList) {
  ebonoContainer.classList.remove('active'); // Remove active class from .ebono-container
  }
  if (listado) {
    listado.innerHTML = ""; // Empty the content of #listado
  }
  if (valor) {
    valor.value = ""; // Reset the value of #valor input
  }
  if (openLocator) {
    openLocator.textContent = "Find the nearest newsstand";
  }

  // Select all elements with the class .magazines__plan
  var magazinesPlanItems = document.querySelectorAll('.magazines__plan');

  // Loop through all selected elements
  for (var i = 0; i < magazinesPlanItems.length; i++) {
      // Remove the active class from each element
      magazinesPlanItems[i].classList.remove('active');
  }

  // Finding .magazines__plan--button and changing its text to 'select'
  var magazineButtons = document.querySelectorAll('.magazines__plan--button');
  magazineButtons.forEach(function(button) {
      button.innerText = 'select';
  });

  // Remove 'active' class to .gift-card-recipient-form-home
  // First, select the element
  let elem = document.querySelector('.gift-card-recipient-form-home');

  // Then, toggle the 'active' class
  elem.classList.toggle('active');

  // First, select the checkbox
  let checkbox = document.querySelector('input[name="items[0]properties[__shopify_send_gift_card_to_recipient]"]');

  // Then, change the checked state
  checkbox.checked = false; // Change this to true for checked, false for unchecked

  // After that, create a new 'change' event
  let event = new Event('change', {
      bubbles: true,
      cancelable: true
  });

  // Finally, dispatch the event
  checkbox.dispatchEvent(event);
});
</script>

<script>
  // Change market 
  document.addEventListener('DOMContentLoaded', function() {
    const selectMarketButtons = document.querySelectorAll('.select-market');
    var openLocator = document.querySelector("#open-locator");

    selectMarketButtons.forEach((button) => {
        button.addEventListener('click', function(event) {
            event.preventDefault();

            if (openLocator && openLocator.classList) {
              openLocator.classList.remove('show');
            }

            var sectionWelcomeGifts = document.querySelector('#magazines__welcome-gifts');
            sectionWelcomeGifts.style.display = 'none';

            // Reset all buttons to secondary
            selectMarketButtons.forEach((btn) => {
                btn.classList.remove('button--primary');
                btn.classList.remove('active');
                btn.classList.add('button--secondary');
            });

            var confirmation = document.querySelector('#magazines__confirmation');
            confirmation.style.display = 'none';

            // Set the clicked button to primary
            this.classList.add('button--primary');
            this.classList.remove('button--secondary');
            this.classList.add('active');

            // Remove active from all .plans-swiper items
            const plansSwiperItems = document.querySelectorAll('.plans-swiper');
            plansSwiperItems.forEach((item) => {
                item.classList.remove('active');
            });

            // Add active class to the element with id equal to the data-id of clicked element
            const dataId = this.dataset.id;
            const targetElement = document.getElementById(dataId);
            if(targetElement) {
                targetElement.classList.add('active');
            }

            // Remove active from all .magazines__plan
            const magazinePlans = document.querySelectorAll('.magazines__plan');
            magazinePlans.forEach((plan) => {
                plan.classList.remove('active');
            });

            // Deselect all buttons
            var buttons = document.querySelectorAll('.magazines__plan--button');
            buttons.forEach(function(button) {
                button.innerText = 'select';
            });

        });
    });
});


</script>

<script>
  const giftCardsSwiper = new Swiper('.gift-cards-swiper', { 
    // Optional parameters
    direction: 'horizontal',
    loop: false,
    slidesPerView: "auto",
    spaceBetween: 25,
    centeredSlides: true,
    breakpoints: {
        749: {
            slidesPerView:2, 
            spaceBetween: 50,
            centeredSlides: false,
        }
    },
    // If we need pagination
    pagination: {
      el: '.gift-cards-swiper-pagination',
      clickable: true
    },
  });

  {% comment %} const giftsSwiper = new Swiper('.gifts-swiper', {
    // Optional parameters
    direction: 'horizontal',
    loop: true,
  
    // If we need pagination
    pagination: {
      el: '.swiper-pagination',
      clickable: true
    },
  
    // Navigation arrows
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    slidesPerView: "auto",
    spaceBetween: 25,
    centeredSlides: true,
    breakpoints: {
        749: {
            slidesPerView:4, 
            spaceBetween: 30,
            centeredSlides: false,
        }
    }
  }); {% endcomment %}
  

  var welcomeGiftsData = {
    {% for product in section.settings.collection.products %}
      "{{ product.id }}":  {% if localization.market.handle == "es" %} {{ product.metafields.custom.welcome_gifts.value | json }}{% else %}null{% endif %}
      {% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // get all the buttons
  var buttons = document.querySelectorAll('.magazines__plan--button');
  var openLocator = document.querySelector("#open-locator");
  var ebonoContainer = document.querySelector(".ebono-container");
  var listado = document.querySelector("#listado");
  var valor = document.querySelector("#valor");

  // add an event listener to each button
  buttons.forEach(function(button) {
    button.addEventListener('click', function(e) {
      // prevent the default action
      e.preventDefault();

      // Check if the button has the data-e-bono attribute set to "true"
      if (button.getAttribute('data-e-bono') === "true") {
        if (openLocator && openLocator.classList) {
          openLocator.classList.add('show');
        }
        if (openLocator) {
          openLocator.textContent = "Find the nearest newsstand";
        }
      } else {
        if (openLocator && openLocator.classList) {
          openLocator.classList.remove('show');
        }
        if (ebonoContainer && ebonoContainer.classList) {
          ebonoContainer.classList.remove('active'); // Remove active class from .ebono-container
        }
        if (listado) {
          listado.innerHTML = ""; // Empty the content of #listado
        }
        if (valor) {
          valor.value = ""; // Reset the value of #valor input
        }
        if (openLocator) { 
          openLocator.textContent = "Find the nearest newsstand";
        }
      }

      var productObj = {
        name: this.getAttribute('data-dl-product-name'),
        id: this.getAttribute('data-dl-product-id'),
        price: this.getAttribute('data-dl-product-price'),
        brand: this.getAttribute('data-dl-product-brand'),
        variant: this.getAttribute('data-dl-product-variant'),
        category: this.getAttribute('data-dl-product-category'),
      };

      // Push the product details to the dataLayer
      pushToDataLayer(productObj);

      // get the product ID from the button's data-id attribute
      var productMonthly = e.target.getAttribute('data-monthly');

      // get the product ID from the button's data-id attribute
      var productId = e.target.getAttribute('data-id');

      // get the gifts data for this product
      // Locate the element using the data-id attribute
      var national = document.querySelector('[data-id="plans-national"]');

      // Check if the element exists and has the 'active' class
      if (national && national.classList.contains('active')) {
      var giftsData = welcomeGiftsData[productId];
      }

      if(productMonthly == "true") {
        document.querySelector('.disclaimer--yearly').classList.remove("active");
        document.querySelector('.disclaimer--monthly').classList.add("active");
      } else {
        document.querySelector('.disclaimer--yearly').classList.add("active");
        document.querySelector('.disclaimer--monthly').classList.remove("active");
      }

      if(productMonthly == "true") {
        document.querySelector('.renewal--yearly').classList.remove("active");
        document.querySelector('.renewal--monthly').classList.add("active");
      } else {
        document.querySelector('.renewal--yearly').classList.add("active");
        document.querySelector('.renewal--monthly').classList.remove("active");
      } 

      // handle case where there are no gifts for this product
      if (!giftsData) {
        var sectionWelcomeGifts = document.querySelector('#magazines__welcome-gifts');
        sectionWelcomeGifts.style.display = 'none';
      } else {
        var sectionWelcomeGifts = document.querySelector('#magazines__welcome-gifts');
        sectionWelcomeGifts.style.display = 'block';
        // create the slider HTML
        var sliderHTML = '<div class="swiper-wrapper">';
        
        let isSingleGift = giftsData.length <= 1;


        giftsData.forEach(function(gift) {
          sliderHTML += '<div class="swiper-slide">';
          sliderHTML += '<div class="magazines__welcome-gift--item">';
          sliderHTML += '<img src="' + gift.featured_image + '" alt="">';
